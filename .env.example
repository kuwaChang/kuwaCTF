# kuwaCTF の設定ファイルの見本。
# このファイルを .env という名前でコピーし、使う行の先頭の # を外して値を書く。
#   PowerShell: Copy-Item .env.example .env
# .env は Git に含めない（.gitignore 済み）。PCごとに作る。
# PowerShell の $env: や setx で設定した値があれば、そちらが優先される。
# 値を変えたら、サーバーを起動し直す。

# ===== サーバー =====

# セッション署名用の秘密の文字列。固定すると、再起動してもログインが切れない。
# 長いランダムな文字列にする（例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" で作る）
# SESSION_SECRET=

# 問題文などに出すサーバーのアドレス。未設定なら自機のIPを自動で選ぶ。
# 仮想アダプター（WSL / Docker の 172.x）が選ばれて学生から届かないときに設定する。
# SERVER_HOST=133.10.5.20

# 追加で許可する接続元のアドレス帯（CIDR、カンマ区切り）。
# 未設定ならループバックとプライベートIP（10/8、172.16/12、192.168/16）だけを許可する。
# 学内の端末にグローバルIPが割り当てられているときに設定する。
# ALLOWED_NETWORKS=133.10.0.0/16

# ===== AI チューター =====

# Ollama の URL
# OLLAMA_BASE_URL=http://localhost:11434

# チューターのモデル（既定: elyza-jp:8b）
# OLLAMA_MODEL=qwen3:32b

# 思考モード（Qwen3 など）。1 でオン。通常はオフのまま
# OLLAMA_THINK=0

# 知識ベース検索の埋め込みモデル（既定: bge-m3）
# OLLAMA_EMBEDDING_MODEL=bge-m3

# 埋め込みモデルに使うGPUの層数。既定は 0（CPUで計算し、GPUはチャットモデル専用にする）
# OLLAMA_EMBEDDING_NUM_GPU=0

# ChromaDB の URL
# CHROMA_URL=http://localhost:8000

# 知識ベース検索で使う関連度の下限（既定: 0.15）
# TUTOR_MIN_RELEVANCE=0.15

# ===== コード実行（Docker イメージ） =====

# CODE_DOCKER_IMAGE_PYTHON=python:3.12-alpine
# CODE_DOCKER_IMAGE_C=gcc:12-bookworm
# CODE_DOCKER_IMAGE_CPP=gcc:12-bookworm
# CODE_DOCKER_IMAGE_JAVA=eclipse-temurin:17-jdk
